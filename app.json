{
  "expo": {
    "name": "Regulare Mobile",
    "slug": "regulare-app",
    "scheme": "regularemobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1c3d5a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.regulareapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "O aplicativo acessa suas fotos para anexar ao sinistro.",
          "cameraPermission": "O aplicativo usa a câmera para fotografar o sinistro."
        }
      ],
      "expo-sharing",
      "react-native-compressor",
      "expo-video",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O aplicativo usa sua localização para registrar as coordenadas do sinistro."
        }
      ],
      "expo-background-task",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#1c3d5a"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
